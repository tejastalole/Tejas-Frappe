2026-08-10 12:44:55,283 INFO ipython import frappe
2026-08-10 12:44:55,283 INFO ipython from biometric_integration.attendance_events import create_attendance_event
2026-08-10 12:44:55,283 INFO ipython from biometric_integration.attendance_state import AttendanceValidationError, DuplicatePunchError, get_event_link_field
2026-08-10 12:44:55,283 INFO ipython settings = frappe.get_single("Biometric Settings")
2026-08-10 12:44:55,284 INFO ipython create_ec = bool(settings.create_employee_checkin)
2026-08-10 12:44:55,284 INFO ipython for name in frappe.get_all(
    "Biometric Punch Log",
    filters={"processing_status": "Rejected", "event_category": "Check In Out"},
    pluck="name",
):
    doc = frappe.get_doc("Biometric Punch Log", name)
    if not doc.employee:
        continue
    try:
        result = create_attendance_event(
            punch_log_name=doc.name,
            employee=doc.employee,
            user_id=doc.user_id,
            punch_time=doc.punch_time,
            punch_status=doc.punch_status,
            device_name=doc.device,
            serial_number=doc.serial_number,
            source=doc.source or "ADMS",
            create_employee_checkin=create_ec,
        )
        if result:
            link_field = get_event_link_field(result["category"])
            checkin = None
            if result["category"] == "Check In Out":
                checkin = frappe.db.get_value("Biometric Check In Check Out", result["name"], "employee_checkin")
            vals = {
                "processed": 1,
                "processing_status": "Accepted",
                "rejection_reason": "",
                link_field: result["name"],
                "event_category": result["category"],
            }
            if checkin:
                vals["employee_checkin"] = checkin
            doc.db_set(vals, update_modified=True)
            print("Accepted", name, "->", result["name"])
    except (AttendanceValidationError, DuplicatePunchError) as e:
        print("Still rejected", name, e)
2026-08-10 12:44:55,284 INFO ipython frappe.db.commit()
2026-08-10 12:44:55,284 INFO ipython print("Check In Check Out count:", frappe.db.count("Biometric Check In Check Out"))
2026-08-10 12:44:55,284 INFO ipython === session end ===
