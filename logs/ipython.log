2026-05-25 04:52:34,129 INFO ipython frappe.set_user("Administrator")
2026-05-25 04:52:34,129 INFO ipython today = frappe.utils.today()
2026-05-25 04:52:34,129 INFO ipython m = "MEM-00030"
2026-05-25 04:52:34,129 INFO ipython # fix today's bad rows where in/out within 2s
2026-05-25 04:52:34,129 INFO ipython fixed = 0
2026-05-25 04:52:34,129 INFO ipython for row in frappe.get_all("Attendance Log", filters={"attendance_date": today}, fields=["name", "check_in_time", "check_out_time"]):
    if not row.check_in_time or not row.check_out_time:
        continue
    cin = _time_to_seconds(row.check_in_time)
    cout = _time_to_seconds(row.check_out_time)
    if cin is not None and cout is not None and abs(cin - cout) <= 2:
        frappe.db.set_value("Attendance Log", row.name, "check_out_time", None)
        fixed += 1
print("cleared autofilled checkout on", fixed, "records")
