    "Biometric Tea Break",
]
2026-08-14 09:36:04,448 INFO ipython for dt in doctypes:
    rows = frappe.get_all(dt, fields=["name", "attendance_date"])
    to_delete = []
    to_keep = []
    for row in rows:
        d = getdate(row.attendance_date) if row.attendance_date else None
        if d == today_date:
            to_keep.append(row.name)
        else:
            to_delete.append(row.name)
    for name in to_delete:
        frappe.delete_doc(dt, name, ignore_permissions=True, force=True)
    print(f"{dt}: total={len(rows)}, deleted={len(to_delete)}, kept_today={len(to_keep)}")
