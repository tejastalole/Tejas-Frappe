2026-08-21 17:43:46,457 INFO ipython import json, time
2026-08-21 17:43:46,457 INFO ipython import websocket
2026-08-21 17:43:46,457 INFO ipython import frappe
2026-08-21 17:43:46,458 INFO ipython from currencyinfo.currency_info.stream import parse_trade, _persist_tick, get_stream_url
2026-08-21 17:43:46,458 INFO ipython url = get_stream_url()
2026-08-21 17:43:46,458 INFO ipython print("url", url)
2026-08-21 17:43:46,458 INFO ipython ws = websocket.create_connection(url, timeout=20)
2026-08-21 17:43:46,458 INFO ipython raw = ws.recv()
2026-08-21 17:43:46,458 INFO ipython ws.close()
2026-08-21 17:43:46,458 INFO ipython payload = json.loads(raw)
2026-08-21 17:43:46,458 INFO ipython tick = parse_trade(payload)
2026-08-21 17:43:46,459 INFO ipython print("tick", tick)
2026-08-21 17:43:46,459 INFO ipython _persist_tick(tick, 1)
2026-08-21 17:43:46,459 INFO ipython frappe.db.commit()
2026-08-21 17:43:46,459 INFO ipython print("saved price", frappe.db.get_single_value("Currency Info Settings", "last_price"))
2026-08-21 17:43:46,459 INFO ipython print("status", frappe.db.get_single_value("Currency Info Settings", "connection_status"))
