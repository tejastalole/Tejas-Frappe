2026-08-10 12:19:43,305 INFO ipython import frappe
2026-08-10 12:19:43,306 INFO ipython from biometric_integration.attendance_events import create_attendance_event
2026-08-10 12:19:43,306 INFO ipython from biometric_integration.attendance_state import (
    AttendanceValidationError,
    DuplicatePunchError,
    get_event_link_field,
)
2026-08-10 12:19:43,306 INFO ipython reprocessed = 0
2026-08-10 12:19:43,306 INFO ipython failed = 0
2026-08-10 12:19:43,306 INFO ipython for name in frappe.get_all(
    "Biometric Punch Log",
    filters={"processing_status": "Rejected", "event_category": ["in", ["Lunch Break", "Tea Break"]]},
    pluck="name",
):
    doc = frappe.get_doc("Biometric Punch Log", name)
    if not doc.employee:
        continue
    try:
        result = create_attendance_event(
            punch_log_name=doc.name,
            employee=doc.employee,
            user_id=doc.user_id,
            punch_time=doc.punch_time,
            punch_status=doc.punch_status,
            device_name=doc.device,
            serial_number=doc.serial_number,
            source=doc.source or "ADMS",
            create_employee_checkin=False,
        )
        if result:
            link_field = get_event_link_field(result["category"])
            doc.db_set(
                {
                    "processed": 1,
                    "processing_status": "Accepted",
                    "rejection_reason": "",
                    link_field: result["name"],
                    "event_category": result["category"],
                },
                update_modified=True,
            )
            reprocessed += 1
            print("Accepted", name, "->", result["name"], result["category"])
        else:
            print("No result for", name)
    except (AttendanceValidationError, DuplicatePunchError) as e:
        failed += 1
        print("Still rejected", name, str(e))
2026-08-10 12:19:43,307 INFO ipython frappe.db.commit()
2026-08-10 12:19:43,307 INFO ipython print("Tea Break count:", frappe.db.count("Biometric Tea Break"))
2026-08-10 12:19:43,307 INFO ipython print("Lunch Break count:", frappe.db.count("Biometric Lunch Break"))
2026-08-10 12:19:43,307 INFO ipython print("reprocessed", reprocessed, "failed", failed)
2026-08-10 12:19:43,307 INFO ipython === session end ===
